def cmd_register(args):
    """Register the logged-in user into an opportunity (individual team)."""
    sess = load_auth()
    if not sess.get("access_token"):
        die("not logged in — run `unstop login`")
    ident = require_id(args.id)
    opp = fetch_opp(ident)
    title = (opp or {}).get("title") or f"#{ident}"
    if args.json and not args.yes:
        pass  # proceed silently in json mode
    # pre-check eligibility when the endpoint answers
    elig = api_get(f"/api/registration/can-player-register/{ident}",
                   quiet=True)
    if isinstance(elig, dict) and elig.get("status") is False:
        die(f"not eligible: {elig.get('message') or 'unknown reason'}")

    profile = _profile_decrypted() or {}
    name = args.name or profile.get("name") or \
        ((sess.get("user") or {}).get("name")) or input("Your full name: ").strip()
    email = profile.get("email") or (sess.get("user") or {}).get("email")
    if not email:
        die("could not determine your email from the session")
    gender = (args.gender or "").upper()
    if gender not in ("F", "M", "T", "I", "NB", "O"):
        try:
            gender = input("Gender (F/M/T/I/NB/O): ").strip().upper()
        except EOFError:
            gender = ""
    if gender not in ("F", "M", "T", "I", "NB", "O"):
        die("gender required: one of F/M/T/I/NB/O")

    body = {
        "team": {
            "name": str(name),
            "subscription": 1,
            "players": [{"player_type": 1, "email": email,
                         "name": str(name), "gender": gender}],
        },
        "source_url": public_url(opp) or f"{BASE}/competitions/x/register",
        "client_id": None,
        "time_zone": "Asia/Kolkata",
    }
    if not args.yes and not args.json:
        ans = input(c(f"Register into “{title}” as {name} ({gender})? [y/N] ",
                      YELLOW)).strip().lower()
        if ans != "y":
            print("aborted.")
            return
    ok, resp = api_post(
        f"/api/registration/team/{ident}/create", body)
    if args.json:
        print(json.dumps(resp, indent=2, ensure_ascii=False))
    if ok and isinstance(resp, dict) and resp.get("status") is not False:
        team = (resp.get("data") or {}).get("oRegisteredTeam") or {}
        tid = team.get("id") or ""
        msg = resp.get("message") or "registered successfully"
        if not args.json:
            print(c(f"✓ {msg} · {title}", GREEN)
                  + (c(f"  (team #{tid})", DIM) if tid else ""))
            url = public_url(opp)
            if url:
                print(c(url, DIM))
    else:
        msg = resp.get("message") if isinstance(resp, dict) else str(resp)[:200]
        if msg and "verify your mobile" in str(msg).lower():
            print(c("Unstop requires a verified mobile number for this event.", YELLOW))
            print(c("Add + verify one on unstop.com (Settings → Mobile), or:", DIM))
            print(c(f"  unstop mobile add +91XXXXXXXXXX", DIM))
            print(c("then retry: unstop register " + ident, DIM))
        die(f"registration failed: {msg}")


def _mobile_dispatch(args):
    if args.mobile:
        cmd_mobile_add(args)
    else:
        die("usage: unstop mobile add +91XXXXXXXXXX [--otp NNNNNN]")


def cmd_mobile_add(args):
    """Submit a mobile number and verify it via OTP (email-style flow)."""
    sess = load_auth()
    uid = (sess.get("user") or {}).get("id") or ""
    if not sess.get("access_token"):
        die("not logged in")
    raw = args.mobile.lstrip("+").replace(" ", "")
    if not re.fullmatch(r"\d{10,13}", raw):
        die("pass digits only, e.g. 919876543210 or 9876543210")
    ok, resp = api_post("/api/update/user/mobile",
                        {"user_id": int(uid) if uid.isdigit() else uid,
                         "mobile": "+" + raw})
    if not ok or not (isinstance(resp, dict) and resp.get("status", True)):
        die(f"mobile submit failed: {resp}")
    print(c("✚ OTP sent to +" + raw, GREEN))
    try:
        otp = args.otp or getpass.getpass("Enter OTP: ").strip()
    except (EOFError, KeyboardInterrupt):
        die("no OTP entered — rerun with --otp")
    email_like = raw + "@mobileairtel.com" if raw.startswith("91") \
        else "91" + raw[-10:] + "@mobileairtel.com"
    ok2, resp2 = api_post(
        "/api/micro/oauth/v2/login/otp/verify",
        {"otp": otp.strip(), "email": email_like,
         "grant_type": "otp", "verify_via": ["mobile"]})
    if ok2:
        # refresh the saved session tokens if a new encData came back
        enc = resp2.get("encData") if isinstance(resp2, dict) else None
        if enc:
            fresh = decrypt_encdata(enc)
            if fresh and fresh.get("access_token"):
                save = load_auth()
                save["access_token"] = fresh["access_token"]
                save["refresh_token"] = fresh.get("refresh_token")
                save_auth(save)
        print(c("✓ mobile verified", GREEN))
    else:
        die(f"verification failed: {resp2}")


# ---------------------------------------------------------------- cli
def main():
    ap = argparse.ArgumentParser(
        prog="unstop", description="Browse Unstop.com from the terminal.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
          examples:
            unstop hackathons                 live hackathons
            unstop hackathons -k ai           keyword filter (server-side)
            unstop closing -d 7               all types closing within 7 days
            unstop competitions -n 15 -p 2    paginate
            unstop search "ai hackathon"      global search
            unstop detail 1742795             one event's info
            unstop stats 1736086              top colleges in an event
            unstop watch add 1742795          track it locally
            unstop login                      OTP login (email or mobile)
            unstop whoami                     account details
            unstop --json internships         machine-readable output"""))
    ap.add_argument("--json", action="store_true", help="raw JSON output")
    sub = ap.add_subparsers(dest="cmd")

    def common(p):
        p.add_argument("-p", "--page", type=int, default=1)
        p.add_argument("-n", "--limit", type=int, default=10)
        p.add_argument("-k", "--keyword", help="server-side title filter")
        p.add_argument("--sort", choices=SORTS, default="latest")
        p.add_argument("--status", choices=STATUSES, default="live")

    for name in sorted(TYPES):
        sp = sub.add_parser(name, help=f"list live {plural(name)}")
        common(sp)
        sp.set_defaults(fn=cmd_list, type=name)
        for alias in TYPES[name]:
            if alias == name:
                continue
            sa = sub.add_parser(alias, help=f"alias for '{name}'")
            common(sa)
            sa.set_defaults(fn=cmd_list, type=name)

    sp = sub.add_parser("closing", help="events closing within N days")
    sp.add_argument("-d", "--days", type=int, default=7)
    sp.add_argument("--pages", type=int, default=3,
                    help="pages scanned per type (default 3)")
    sp.set_defaults(fn=cmd_closing)

    sp = sub.add_parser("search", help="global search")
    sp.add_argument("query", nargs="+")
    sp.add_argument("-n", "--limit", type=int, default=10)
    sp.set_defaults(fn=cmd_search)

    sp = sub.add_parser("detail", help="details for an id")
    sp.add_argument("id")
    sp.set_defaults(fn=cmd_detail)

    sp = sub.add_parser("stats", help="top colleges for an event")
    sp.add_argument("id")
    sp.add_argument("--top", type=int, default=10)
    sp.set_defaults(fn=cmd_stats)

    sp = sub.add_parser("orgs", help="browse organisations")
    common(sp)
    sp.add_argument("--home", action="store_true", help="featured orgs only")
    sp.set_defaults(fn=cmd_orgs)

    sp = sub.add_parser("platform", help="platform-wide stats")
    sp.set_defaults(fn=cmd_platform)

    sp = sub.add_parser("open", help="print/open event URL")
    sp.add_argument("id")
    sp.set_defaults(fn=cmd_open)

    sp = sub.add_parser("types", help="supported types")
    sp.set_defaults(fn=cmd_types)

    # ---- v3: public content APIs --------------------------------------
    sp = sub.add_parser("blogs", help="browse Unstop blog posts")
    sp.add_argument("query", nargs="*", help="keyword filter (title/excerpt)")
    common(sp)
    sp.add_argument("--pages", type=int, default=3,
                    help="pages scanned (default 3)")
    sp.add_argument("--category", type=int, action="append",
                    help="category id from `unstop cats` (repeatable)")
    sp.set_defaults(fn=cmd_blogs)

    sp = sub.add_parser("blog", help="read one post by slug or id")
    sp.add_argument("id")
    sp.set_defaults(fn=cmd_blog)

    sp = sub.add_parser("cats", help="blog categories")
    sp.set_defaults(fn=cmd_cats)

    sp = sub.add_parser("tags", help="platform tags")
    common(sp)
    sp.set_defaults(fn=cmd_tags)

    sp = sub.add_parser("watch", help="local watchlist (add/rm/list)")
    sp.add_argument("action", choices=["add", "rm", "list"], nargs="?",
                    default="list")
    sp.add_argument("id", nargs="?")
    sp.set_defaults(fn=cmd_watch)

    # ---- auth ----------------------------------------------------------
    sp = sub.add_parser(
        "login", help="login via OTP (email or mobile)")
    sp.add_argument("email", nargs="?", help="email or 10-digit mobile")
    sp.add_argument("--otp", help="OTP code (skip the prompt)")
    sp.add_argument("--expose", action="store_true",
                    help="headless/agent mode: serve a browser login page "
                         "on 0.0.0.0:PORT so the owner can complete login "
                         "from any device; session saved server-side")
    sp.add_argument("--port", type=int, default=8777,
                    help="port for --expose (default 8777)")
    sp.add_argument("--public-ip", default=None,
                    help="public hostname/IP to advertise with --expose "
                         "(auto-detected if omitted)")
    sp.set_defaults(fn=_login_dispatch)

    sp = sub.add_parser(
        "login-qr", help="print a scannable QR of the --expose login URL")
    sp.add_argument("--port", type=int, default=8777)
    sp.add_argument("--public-ip", default=None)
    sp.set_defaults(fn=cmd_login_qr)

    sp = sub.add_parser(
        "login-token",
        help="paste an existing access token instead of OTP")
    sp.add_argument("token", nargs="?", help="access token (prompted if omitted)")
    sp.set_defaults(fn=cmd_login_token)

    sp = sub.add_parser(
        "login-password",
        help="classic email + password login (for accounts that have one)")
    sp.add_argument("email", nargs="?", help="account email")
    sp.add_argument("-p", "--password", help="password (prompted if omitted)")
    sp.set_defaults(fn=cmd_login_password)

    sp = sub.add_parser(
        "login-refresh",
        help="exchange a refresh_token for a fresh session")
    sp.add_argument("refresh_token", nargs="?",
                    help="(default: the saved refresh token)")
    sp.set_defaults(fn=cmd_login_refresh)

    sp = sub.add_parser(
        "login-social",
        help="Google / Facebook / LinkedIn login bridge (paste provider "
             "token or LinkedIn code in a browser page)")
    sp.add_argument("--port", type=int, default=8778)
    sp.add_argument("--public-ip", default=None)
    sp.set_defaults(fn=cmd_login_social)

    sp = sub.add_parser("whoami", help="show logged-in account details")
    sp.set_defaults(fn=cmd_whoami)

    sp = sub.add_parser("logout", help="clear saved session")
    sp.set_defaults(fn=cmd_logout)

    sp = sub.add_parser("status", help="is the session alive?")
    sp.set_defaults(fn=cmd_status)

    # ---- account (authed) ----------------------------------------------
    sp = sub.add_parser("me", help="your profile summary")
    sp.set_defaults(fn=cmd_me)

    sp = sub.add_parser("registrations", help="opportunities you registered in")
    sp.add_argument("-n", "--limit", type=int, default=15)
    sp.set_defaults(fn=cmd_registrations)

    sp = sub.add_parser("my-competitions", help="competitions dashboard data")
    common(sp)
    sp.set_defaults(fn=cmd_my_competitions)

    sp = sub.add_parser("certificates", help="your certificates + links")
    sp.add_argument("-n", "--limit", type=int, default=15)
    sp.set_defaults(fn=cmd_certificates)

    sp = sub.add_parser("register",
                        help="register yourself into an opportunity")
    sp.add_argument("id", help="opportunity id (from `unstop hackathons` etc.)")
    sp.add_argument("-g", "--gender", help="F / M / T / I / NB / O")
    sp.add_argument("--name", help="override the name used for registration")
    sp.add_argument("-y", "--yes", action="store_true",
                    help="skip confirmation prompt")
    sp.set_defaults(fn=cmd_register)

    sp = sub.add_parser("mobile",
                        help="mobile verification (add/rm/list)")
    sp.add_argument("action", choices=["add"], nargs="?", default="add")
    sp.add_argument("mobile", nargs="?", help="+91XXXXXXXXXX")
    sp.add_argument("--otp", help="OTP code (skip prompt)")
    sp.set_defaults(fn=_mobile_dispatch)

    args = ap.parse_args()
    fn = getattr(args, "fn", None)
    if not fn:
        ap.print_help()
        return
    # attach global --json onto subcommands
    if not hasattr(args, "json"):
        args.json = False
    fn(args)


if __name__ == "__main__":
    main()
