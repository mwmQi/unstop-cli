def _public_ip():
    try:
        with urllib.request.urlopen(
                "https://api.ipify.org", timeout=5) as r:
            return r.read().decode().strip()
    except Exception:
        try:
            with urllib.request.urlopen(
                    "http://checkip.amazonaws.com", timeout=5) as r:
                return r.read().decode().strip()
        except Exception:
            socket_ip = urllib.request.urlopen  # noqa: F841
            return "<VPS-IP>"


def cmd_login_expose(args):
    """Headless login bridge for agents: serve a mini form, save session."""
    state = {"email": None, "is_mobile": False}

    class Handler(http.server.BaseHTTPRequestHandler):
        def _send(self, code, body, ctype="text/html; charset=utf-8"):
            data = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            self._send(200, _EXPOSE_PAGE)

        def do_POST(self):
            ln = int(self.headers.get("Content-Length") or 0)
            try:
                payload = json.loads(self.rfile.read(ln) or b"{}")
            except Exception:
                payload = {}
            path = urllib.parse.urlparse(self.path).path
            if path == "/start":
                ident = str(payload.get("id") or "").strip()
                if not ident:
                    return self._send_json({"ok": False,
                                            "message": "empty id"})
                email, is_mobile = _norm_email(ident)
                ok, resp = api_post(
                    "/api/micro/oauth/v2/login/otp/send",
                    {"email": email, "e": True}, auth=False)
                msg = ((resp.get("data") or {}).get("message")
                       if isinstance(resp, dict) else str(resp)[:120])
                if ok and isinstance(resp, dict) and \
                        (resp.get("data") or {}).get("status"):
                    state["email"], state["is_mobile"] = email, is_mobile
                    disp = ident if "@" in ident else "+91 " + ident[-10:]
                    return self._send_json(
                        {"ok": True, "message": f"OTP sent to {disp}"})
                return self._send_json(
                    {"ok": False, "message": f"send failed: {msg}"})
            if path == "/verify":
                if not state.get("email"):
                    return self._send_json(
                        {"ok": False, "message": "no pending OTP"})
                otp = str(payload.get("otp") or "").strip()
                body = {"otp": otp, "email": state["email"], "e": True,
                        "channels": ["sms" if state["is_mobile"] else "email"],
                        "verify_via": ["mobile" if state["is_mobile"]
                                       else "email"],
                        "with_access_token": True}
                if state["is_mobile"]:
                    body = {"otp": otp, "email": state["email"],
                            "grant_type": "otp",
                            "verify_via": ["mobile"]}
                ok, resp = api_post(
                    "/api/micro/oauth/v2/login/otp/verify", body, auth=False)
                if not ok:
                    return self._send_json(
                        {"ok": False, "message": "wrong/expired OTP"})
                enc = resp.get("encData") if isinstance(resp, dict) else None
                if not enc:
                    return self._send_json(
                        {"ok": False, "message": "unexpected response"})
                sess = decrypt_encdata(enc)
                if not sess or not sess.get("access_token"):
                    return self._send_json(
                        {"ok": False, "message": "decrypt failed"})
                save_auth({
                    "access_token": sess.get("access_token"),
                    "refresh_token": sess.get("refresh_token"),
                    "expires_in": sess.get("expires_in"),
                    "token_type": sess.get("token_type", "Bearer"),
                    "saved_at": dt.datetime.now().isoformat(timespec="seconds"),
                    "user": {k: sess.get(k) for k in
                             ("id", "name", "email", "mobile")},
                })
                who = sess.get("name") or sess.get("email") or "user"
                print(f"\n✓ logged-in via browser as {who} "
                      f"(session saved)", flush=True)
                return self._send_json(
                    {"ok": True,
                     "message": f"Logged in as {who}. You can close this tab."})
            return self._send(404, "not found")

        def _send_json(self, obj):
            self._send(200, json.dumps(obj), "application/json")

        def log_message(self, *a):      # quiet
            pass

    port = args.port
    srv = http.server.ThreadingHTTPServer(("0.0.0.0", port), Handler)
    ip = args.public_ip or _public_ip()
    url = f"http://{ip}:{port}/"
    print(c("── unstop login bridge ──", BOLD))
    print(c(f"open in any browser:  ", DIM) + c(url, BOLD, CYAN))
    print(c("(owner fills email/mobile + OTP there; session is saved here "
            "server-side — token never touches the browser)", DIM))
    print(c("ctrl-c to stop once logged in", DIM))
    try:
        srv.serve_forever()             # exactly one loop (hang pitfall)
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
    sess = load_auth()
    if sess.get("access_token"):
        u = sess.get("user") or {}
        print(c(f"✓ Logged in as {u.get('name') or u.get('email')}", GREEN))


def cmd_login_qr(args):
    """Terminal QR of the expose URL (for phone cameras / agent screenshots).

    Renders a scannable QR using pure-python encoding (byte mode, ECC L)
    without external deps."""
    import subprocess as sp
    port = args.port
    ip = args.public_ip or _public_ip()
    url = f"http://{ip}:{port}/"
    have_qrencode = shutil.which("qrencode")
    if have_qrencode:
        sp.run([have_qrencode, "-t", "ansiutf8", url])
    else:
        die("qrencode not installed — apt install qrencode, or just use "
            "`unstop login --expose` which prints the URL")


