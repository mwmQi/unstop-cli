def format_num(v):
    try:
        v = int(v)
    except (TypeError, ValueError):
        return str(v)
    if v >= 10000000:
        return f"{v/10000000:.2f}Cr"
    if v >= 100000:
        return f"{v/100000:.1f}L"
    if v >= 1000:
        return f"{v/1000:.1f}K"
    return str(v)


# ---------------------------------------------------------------- watchlist
def load_watch():
    try:
        with open(WATCH_FILE) as f:
            return json.load(f)
    except Exception:
        return []


def save_watch(items):
    os.makedirs(os.path.dirname(WATCH_FILE), exist_ok=True)
    with open(WATCH_FILE, "w") as f:
        json.dump(items, f, indent=1, ensure_ascii=False)


def cmd_watch(args):
    items = load_watch()
    if args.action == "add":
        opp = fetch_opp(require_id(args.id))
        if not opp:
            die(f"id {args.id} not found")
        entry = {"id": str(opp.get("id")), "title": opp.get("title"),
                 "url": public_url(opp),
                 "added": dt.date.today().isoformat()}
        if not any(e["id"] == entry["id"] for e in items):
            items.append(entry)
            save_watch(items)
            print(c(f"✚ watching: {entry['title']}  #{entry['id']}", GREEN))
        else:
            print("already watching that one.")
    elif args.action == "rm":
        before = len(items)
        items = [e for e in items if e["id"] != args.id]
        save_watch(items)
        print(c(f"removed {before - len(items)} item(s).", YELLOW))
    else:  # list
        if not items:
            print("Watchlist empty. Add one: unstop watch add <id>")
            return
        print(c(f"── watchlist · {len(items)} ──", BOLD)); print()
        for e in items:
            fresh = fetch_opp(e["id"]) or {}
            tl = time_left(fresh) if fresh else "?"
            colr = GREEN if (tl and "left" in tl) else YELLOW
            mark = c("⚠ CLOSING", YELLOW) if (
                tl and (tl.startswith(("0h", "1 day", "2 day"))
                        or (tl.endswith("left") and tl.split()[0].isdigit()
                            and int(tl.split()[0]) <= 3))) else ""
            print(f"  #{e['id']}  {c(e.get('title') or '?', BOLD)}"
                  + (f"\n     {tl and c(tl, colr)}  {mark}" if tl else ""))
        print(c("\ntip: run `unstop watch list` before deadlines, or wire it "
                "into a cron job for alerts.", DIM))


def cmd_open(args):
