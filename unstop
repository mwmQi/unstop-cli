def _detect_provider(token):
    t = token.strip()
    for name, pat in _SOCIAL_HINTS:
        if pat is None:
            continue
        if pat.search(t):
            return name
    # google id_tokens are long JWTs; microsoft tokens are also long —
    # prefer google-one-tap since Unstop's own flow uses it
    if len(t) > 400 and "." in t:
        return "google-one-tap"
    if t.startswith("EAA"):
        return "facebook"
    return "linkedIN"


def _social_exchange(provider, token, state=None):
    """Exchange a provider token/code for an Unstop session (server-side)."""
    ok, resp = api_post(
        "/api/micro/oauth/v2/token",
        {"grant_type": "social", "access_token": token,
         "network": provider, "source_page": None}, auth=False)
    enc = resp.get("encData") if isinstance(resp, dict) else None
    sess = None
    if enc:
        try:
            sess = decrypt_encdata(enc)
        except Exception:
            sess = None
    if not sess and isinstance(resp, dict) and resp.get("access_token"):
        sess = resp
    if not sess or not sess.get("access_token"):
        msg = resp.get("message") if isinstance(resp, dict) \
            else str(resp)[:150]
        return False, f"exchange failed: {msg}"
    save_auth({
        "access_token": sess.get("access_token"),
        "refresh_token": sess.get("refresh_token"),
        "expires_in": sess.get("expires_in"),
        "token_type": sess.get("token_type", "Bearer"),
        "saved_at": dt.datetime.now().isoformat(timespec="seconds"),
        "user": {k: sess.get(k) for k in ("id", "name", "email", "mobile")},
    })
    who = sess.get("name") or sess.get("email") or "user"
    print(f"\n✓ social login ({provider}) as {who} — session saved",
          flush=True)
    if state is not None:
        state["done"] = True
    return True, f"Logged in as {who}. You can close this tab."


def cmd_login_social(args):
    """OAuth proxy bridge: serves a page with one-click provider sign-in
    links + paste box. LinkedIn/Microsoft use real redirect flows; Google/
    Facebook use token paste (One-Tap / FB.login artifacts). The CLI
    exchanges everything server-side via grant_type=social."""
    state = {"done": False}

    class Handler(http.server.BaseHTTPRequestHandler):
        def _send(self, code, body, ctype="text/html; charset=utf-8"):
            data = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            host = self.headers.get("Host") or f"<ip>:{args.port}"
            origin = f"http://{host}"
            path = urllib.parse.urlparse(self.path).path
            if path.startswith("/auth/"):
                prov = path.split("/auth/", 1)[1].split("?")[0]
                target = _SOCIAL_OAUTH_URLS.get(prov)
                if not target:
                    return self._send(404, "unknown provider")
                # linkedin/microsoft: real redirect flow; redirect_uri points
                # BACK to our bridge /cb/<prov> so the code lands here
                if prov == "linkedin":
                    ru = urllib.parse.quote(f"{origin}/cb/linkedin")
                    self.send_response(302)
                    self.send_header("Location", target.replace("{RU}", ru))
                    self.end_headers()
                    return
                if prov == "microsoft":
                    ru = urllib.parse.quote(f"{origin}/cb/microsoft")
                    self.send_response(302)
                    self.send_header("Location", target.replace("{RU}", ru))
                    self.end_headers()
                    return
                # google/facebook: token produced in-browser -> just open page
                self.send_response(302)
                self.send_header("Location", "/")
                self.end_headers()
                return
            if path.startswith("/cb/"):
                prov = path.split("/cb/", 1)[1].split("?")[0]
                qs = urllib.parse.parse_qs(
                    urllib.parse.urlparse(self.path).query)
                code = (qs.get("code") or [""])[0]
                if not code:
                    err = (qs.get("error_description") or
                           qs.get("error") or ["no code"])[0]
                    return self._send(200, _CB_PAGE.replace(
                        "{msg}", f"✗ provider returned: {err}").replace(
                        "{ok}", "err"))
                ok, msg = _social_exchange(prov, code, state)
                page = _CB_PAGE.replace("{msg}", msg).replace(
                    "{ok}", "ok" if ok else "err")
                self._send(200, page)
                return
            page = _SOCIAL_PAGE.replace("{origin}", origin)
            self._send(200, page)

        def do_POST(self):
            ln = int(self.headers.get("Content-Length") or 0)
            try:
                payload = json.loads(self.rfile.read(ln) or b"{}")
            except Exception:
                payload = {}
            provider = str(payload.get("provider") or "").strip()
            token = str(payload.get("token") or "").strip()
            if not token:
                return self._send_json({"ok": False,
                                        "message": "token required"})
            if not provider or provider == "auto":
                provider = _detect_provider(token)
            ok, msg = _social_exchange(provider, token, state)
            return self._send_json({"ok": ok, "message": msg})

        def _send_json(self, obj):
            self._send(200, json.dumps(obj), "application/json")

        def log_message(self, *a):
            pass

    srv = http.server.ThreadingHTTPServer(("0.0.0.0", args.port), Handler)
    ip = args.public_ip or _public_ip()
    url = f"http://{ip}:{args.port}/"
    print(c("── unstop social login bridge ──", BOLD))
    print(c("open in any browser:  ", DIM) + c(url, BOLD, CYAN))
    print(c("providers: google / facebook / linkedin / microsoft "
            "(auto-detect on)", DIM))
    print(c("paste the provider token (or LinkedIn ?code=) in that page",
            DIM))
    print(c("ctrl-c to stop once logged in", DIM))
    try:
        srv.serve_forever()             # exactly one loop
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
    sess = load_auth()
    if sess.get("access_token"):
        u = sess.get("user") or {}
        print(c(f"✓ Logged in as {u.get('name') or u.get('email')}", GREEN))


def cmd_login(args):
    if load_auth().get("access_token"):
        print(c("Already logged in (`unstop logout` first to switch).", YELLOW))
        return
    email, is_mobile = _norm_email(args.email or
                                   input("Email or 10-digit mobile: ").strip())
    ok, resp = api_post("/api/micro/oauth/v2/login/otp/send",
                        {"email": email, "e": True}, auth=False)
    msg = ((resp.get("data") or {}).get("message")
           if isinstance(resp, dict) else str(resp))
    if not ok or not (isinstance(resp, dict)
                      and (resp.get("data") or {}).get("status", ok)):
        die(f"could not send OTP: {msg}")
    print(c("✚ OTP sent to " + (args.email or email), GREEN))

    try:
        otp = args.otp or getpass.getpass("Enter OTP: ").strip()
    except (EOFError, KeyboardInterrupt):
        die("no OTP entered — rerun `unstop login <email>`")
    body = {"otp": otp.strip(), "email": email, "e": True,
            "channels": ["sms" if is_mobile else "email"],
            "verify_via": ["mobile" if is_mobile else "email"],
            "with_access_token": True}
    if is_mobile:
        body = {"otp": otp.strip(), "email": email,
                "grant_type": "otp", "verify_via": ["mobile"]}
    ok, resp = api_post("/api/micro/oauth/v2/login/otp/verify",
                        body, auth=False)
    if not ok:
        die(f"OTP verify failed: {resp if isinstance(resp, str) else msg}")
    enc = resp.get("encData") if isinstance(resp, dict) else None
    if not enc:
        die(f"no encData in response: {str(resp)[:200]}")
    sess = decrypt_encdata(enc)
    if not sess or not sess.get("access_token"):
        die("could not decrypt session (no access_token)")
    save_auth({
        "access_token": sess.get("access_token"),
        "refresh_token": sess.get("refresh_token"),
        "expires_in": sess.get("expires_in"),
        "token_type": sess.get("token_type", "Bearer"),
        "saved_at": dt.datetime.now().isoformat(timespec="seconds"),
        "user": {k: sess.get(k) for k in
                 ("id", "name", "email", "mobile")},
    })
    u = sess.get("name") or sess.get("email") or "user"
    print(c(f"✓ Logged in as {u}  (session saved, chmod 600)", GREEN))


def cmd_login_token(args):
    try:
        tok = args.token or getpass.getpass("Paste access token: ").strip()
    except (EOFError, KeyboardInterrupt):
        die("no token entered — rerun `unstop login-token`")
    if not tok:
        die("empty token")
    save = load_auth()
    save.update({"access_token": tok, "token_type": "Bearer",
                 "saved_at": dt.datetime.now().isoformat(timespec="seconds")})
    save_auth(save)
    # probe it against the profile endpoint (token now loaded from disk)
    payload = api_get("/api/user/profile", {"e": "true"}, quiet=True)
    d = (payload or {}).get("data") if isinstance(payload, dict) else None
    prof = None
    if isinstance(d, dict) and d.get("encData"):
        try:
            prof = decrypt_encdata(d["encData"])
        except Exception:
            prof = None
    user = {}
    if isinstance(prof, dict):
        user = {k: prof.get(k) for k in ("id", "name", "email", "mobile")
                if prof.get(k)}
        save["user"] = user
        save_auth(save)
    if user:
        print(c(f"✓ Token saved · logged in as "
                f"{user.get('name') or user.get('email')}", GREEN))
    else:
        print(c("Token saved (could not verify against /profile — "
                "check `unstop whoami`).", YELLOW))


def _profile_decrypted():
    """GET /api/user/profile and auto-decrypt its `encData` payload."""
    payload = api_get("/api/user/profile", {"e": "true"}, quiet=True)
    d = (payload or {}).get("data") if isinstance(payload, dict) else None
    if not isinstance(d, dict) or not d:
        return None
    if d.get("encData"):
        try:
            return decrypt_encdata(d["encData"])
        except Exception:
            return None
    return d


def cmd_whoami(_args):
    sess = load_auth()
    if not sess.get("access_token"):
        die("not logged in — run `unstop login`")
    p = _profile_decrypted()
    if _args.json:
        print(json.dumps(p if p else sess.get("user") or sess, indent=2,
                         ensure_ascii=False))
        return
    if not isinstance(p, dict) or not p:
        print(c("Session looks expired/invalid. Try `unstop login` again.",
                YELLOW))
        return
    rows = [(k, v) for k, v in sorted(p.items())
            if v not in (None, "", [], {}) and k != "encData"]
    if not rows:
        print(c("(empty profile returned)", YELLOW))
        return
    w = max(len(k) for k, _ in rows)
    for k, v in rows:
        print(f"{c((k + ':').ljust(w + 1), CYAN)} {v}")


def cmd_logout(_args):
    if not load_auth().get("access_token"):
        print("Not logged in.")
        return
    api_post("/api/logout", {}, auth=True)          # best-effort server side
    clear_auth()
    print(c("✓ Logged out (local session removed).", GREEN))


def cmd_status(_args):
    sess = load_auth()
    if not sess.get("access_token"):
        print(c("Not logged in.", YELLOW))
        print(c("get started: unstop login", DIM))
        return
    saved = sess.get("saved_at", "?")
    age = ""
    try:
        age_dt = dt.datetime.now() - dt.datetime.fromisoformat(saved)
        age = f" · saved {age_dt.days}d ago" if age_dt.days else \
              f" · saved {age_dt.seconds//3600}h ago"
    except Exception:
        pass
    u = sess.get("user") or {}
    who = u.get("name") or u.get("email") or "unknown user"
    live = api_get("/api/user/profile", {"e": "true"}, quiet=True)
    state = c("valid", GREEN) if isinstance(live, dict) and live.get("data") \
        else c("expired/unknown", YELLOW)
    print(f"logged in as {c(who, BOLD)} · token {state}{age}")


