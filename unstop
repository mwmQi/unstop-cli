# ---------------------------------------------------------------- http
def _headers(auth=True):
    h = {"User-Agent": UA, "Accept": "application/json",
         "Referer": BASE + "/", "Origin": BASE}
    if auth:
        tok = load_auth().get("access_token")
        if tok:
            h["Authorization"] = "Bearer " + tok
    return h


def api_get(path, params=None, quiet=False, auth=True):
    qs = ("?" + urllib.parse.urlencode(params)) if params else ""
    req = urllib.request.Request(BASE + path + qs, headers=_headers(auth))
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except Exception as e:
        if quiet:
            return None
        body = ""
        if hasattr(e, "read"):
            try:
                body = e.read().decode("utf-8", "replace")[:200]
            except Exception:
                pass
        die(f"request failed for {path}: {e} {body}".rstrip())


def api_post(path, payload=None, auth=True, quiet=False):
    """POST JSON. Returns (ok, parsed_body_or_error_text)."""
    data = json.dumps(payload or {}).encode()
    req = urllib.request.Request(BASE + path, data=data,
                                 headers=_headers(auth), method="POST")
    req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return True, json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        try:
            body = e.read().decode("utf-8", "replace")
        except Exception:
            body = ""
        if quiet:
            return False, None
        try:
            return False, json.loads(body)
        except Exception:
            return False, body[:300]
    except Exception as e:
        if quiet:
            return False, None
        return False, str(e)


def die(msg, code=1):
    print(f"unstop: error: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------------------------------------------------------------- helpers
def resolve_type(name):
    t = ALIASES.get(name.lower())
    if not t:
        die(f"unknown type '{name}'. Valid: {', '.join(sorted(TYPES))}")
    return t


def plural(t):
    return LABEL.get(t, t + "s")


def public_url(opp):
    pu = opp.get("public_url") or ""
    return pu if pu.startswith("http") else (f"{BASE}/{pu}" if pu else "")


def parse_dt(raw):
    if not raw:
        return None
    s = str(raw).split(".")[0].replace("T", " ")
    s = s.split("+")[0].replace("GMT+0530", "").strip()
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d"):
        try:
            return dt.datetime.strptime(s[:19] if len(fmt) > 10 else s[:10], fmt)
        except ValueError:
            continue
    return None


def time_left(opp):
    rl = opp.get("regnRequirements") or {}
    end = parse_dt(rl.get("end_regn_dt") or opp.get("end_date"))
    if not end:
        return None
    days = (end - dt.datetime.now()).days
    secs = (end - dt.datetime.now()).total_seconds()
    if secs <= 0:
        return "closed"
    if days == 0:
        hours = int(secs // 3600)
        return f"{max(hours,1)}h left"
    if days == 1:
        return "1 day left"
    return f"{days} days left"


def fmt_row(i, opp):
    title = (opp.get("title") or "?").strip()
    org = ((opp.get("organisation") or {}).get("name")) or ""
    tl = time_left(opp) or ""
    paid = "₹" if opp.get("paid") else "free"
    loc = {"online": "Online"}.get((opp.get("region") or "").lower(),
                                   (opp.get("region") or ""))
    meta = " · ".join(x for x in [org, loc, paid] if x)
    tail = c(tl, GREEN if ("left" in tl or "h left" in tl) else YELLOW) if tl else ""
    out = f"{c(str(i).rjust(3), DIM)} {c(title, BOLD)}\n    {c(meta, CYAN)}"
    if tail:
        out += f" · {tail}"
    return out + f"   #{opp.get('id')}"


def extract_items(payload):
    d = payload.get("data") if isinstance(payload, dict) else None
    if isinstance(d, dict):
        items = d.get("data")
        if isinstance(items, list):
            return items, d
    if isinstance(d, list):
        return d, {}
    return [], {}


def print_opps(opps):
    for i, o in enumerate(opps, 1):
        print(fmt_row(i, o))


def color_enabled():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


RESET, BOLD, DIM, CYAN, GREEN, YELLOW = (
    "\033[0m", "\033[1m", "\033[2m", "\033[36m", "\033[32m", "\033[33m")


def c(text, *codes):
    if not color_enabled():
        return str(text)
    return "".join(codes) + str(text) + RESET


def fetch_opp(ident):
    """One opportunity by id: authorized endpoint first, then scan listings."""
    payload = api_get(f"/api/opportunity/{ident}", quiet=True)
    opp = (payload or {}).get("data") or {} if isinstance(payload, dict) else {}
    if isinstance(opp, dict) and opp:
        return opp
    for t in sorted(API_TYPE):
        page = 1
        while page <= 8:
            pl = api_get("/api/opportunity/search",
                         {"opportunity": API_TYPE[t], "per_page": 20,
                          "page": page, "sort": "latest", "status": "live"})
            items, _ = extract_items(pl or {})
            match = next((o for o in items if str(o.get("id")) == ident), None)
            if match:
                return match
            if len(items) < 20:
                break
            page += 1
    return None


# ---------------------------------------------------------------- commands
def cmd_list(args):
    t = resolve_type(args.type)
    params = {
        "opportunity": API_TYPE[t],
        "per_page": max(args.limit, 10),
        "page": args.page,
        "sort": args.sort,
        "status": args.status,
    }
    if args.keyword:
        params["keyword"] = args.keyword          # verified server-side filter
    payload = api_get("/api/opportunity/search", params)
    items, meta = extract_items(payload)
    total = meta.get("total")

    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    if not items:
        print(c("No results.", YELLOW))
        return
    head = f"── {plural(t)} · page {args.page}"
    if total:
        head += f" of ~{max(1, (int(total) + args.limit - 1)//args.limit)}"
    if args.keyword:
        head += f" · keyword “{args.keyword}”"
    print(c(head + " ──", BOLD)); print()
    print_opps(items); print()
    hint = []
    if args.page > 1:
        hint.append(f"-p {args.page-1} prev")
    if total and args.page * args.limit < int(total):
        hint.append(f"-p {args.page+1} next")
    if hint:
        print(c("more: unstop " + t + " " + " · ".join(hint), DIM))


def cmd_closing(args):
    """Across all types: opportunities whose registration closes in N days."""
    horizon = dt.datetime.now() + dt.timedelta(days=args.days)
    found = []
    for t in sorted(API_TYPE):
        page = 1
        while page <= args.pages:
            pl = api_get("/api/opportunity/search",
                         {"opportunity": API_TYPE[t], "per_page": 20,
                          "page": page, "sort": "latest", "status": "live"})
            items, _ = extract_items(pl or {})
            if not items:
                break
            for o in items:
                rl = o.get("regnRequirements") or {}
                end = parse_dt(rl.get("end_regn_dt") or o.get("end_date"))
                if end and dt.datetime.now() <= end <= horizon:
                    found.append((end, o))
            if len(items) < 20:
                break
            page += 1

    if args.json:
        print(json.dumps([o for _, o in sorted(found)], indent=2,
                         ensure_ascii=False))
        return
    if not found:
        print(c(f"No registrations closing within {args.days} day(s).", YELLOW))
        return
    found.sort(key=lambda x: x[0])
    print(c(f"── closing within {args.days} day(s) · "
            f"{len(found)} found ──", BOLD)); print()
    print_opps([o for _, o in found])


