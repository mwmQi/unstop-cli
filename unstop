def _norm_email(value):
    """Email, or 10-digit mobile -> Unstop's mobile inbox pattern."""
    value = value.strip()
    if re.fullmatch(r"\d{10}", value):
        return "91" + value + "@mobileairtel.com", True
    if re.fullmatch(r"91\d{10}", value):
        return value + "@mobileairtel.com", True
    return value, False


def _login_dispatch(args):
    if args.expose:
        cmd_login_expose(args)
    else:
        cmd_login(args)


def _finish_socialish(resp, label):
    """Shared: decrypt encData (or read token fields) + save session."""
    enc = resp.get("encData") if isinstance(resp, dict) else None
    sess = None
    if enc:
        try:
            sess = decrypt_encdata(enc)
        except Exception:
            sess = None
    if not sess and isinstance(resp, dict) and resp.get("access_token"):
        sess = resp
    if not sess or not sess.get("access_token"):
        die(f"{label} login: no session in response "
            f"({str(resp)[:150]})")
    save_auth({
        "access_token": sess.get("access_token"),
        "refresh_token": sess.get("refresh_token"),
        "expires_in": sess.get("expires_in"),
        "token_type": sess.get("token_type", "Bearer"),
        "saved_at": dt.datetime.now().isoformat(timespec="seconds"),
        "user": {k: sess.get(k) for k in ("id", "name", "email", "mobile")},
    })
    u = sess.get("name") or sess.get("email") or "user"
    print(c(f"✓ Logged in as {u}  ({label}, session saved)", GREEN))


def cmd_login_password(args):
    """Classic email+password login (grant_type=password)."""
    if load_auth().get("access_token"):
        print(c("Already logged in (`unstop logout` first to switch).", YELLOW))
        return
    email = args.email or input("Email: ").strip()
    try:
        password = args.password or getpass.getpass("Password: ")
    except (EOFError, KeyboardInterrupt):
        die("no password entered — rerun with -p or interactively")
    if not email or not password:
        die("email and password required")
    payload = {"grant_type": "password", "username": email,
               "email": email, "password": password,
               "scope": "*", "network": "", "access_token": "",
               "e": True}
    ok, resp = api_post("/api/micro/oauth/v2/user/login", payload,
                        auth=False)
    if not ok:
        msg = resp.get("message") if isinstance(resp, dict) else str(resp)[:200]
        die(f"password login failed: {msg}")
    _finish_socialish(resp, "password")


def cmd_login_refresh(args):
    """Exchange a refresh_token for a fresh access token.

    NOTE (verified 2026-08-24): Unstop's server currently answers
    `grant_type=refresh_token` with 401 "Unauthorized action." for tokens
    issued via the email-OTP flow, even with XSRF cookie + header — the SPA
    ships this call but it appears disabled server-side. Kept for
    completeness; if Unstop re-enables it this just works."""
    tok = args.refresh_token
    if not tok:
        saved = load_auth()
        tok = saved.get("refresh_token")
    if not tok:
        try:
            tok = getpass.getpass("Paste refresh_token: ").strip()
        except (EOFError, KeyboardInterrupt):
            tok = ""
    if not tok:
        die("no refresh token")
    ok, resp = api_post("/api/micro/oauth/v2/token",
                        {"grant_type": "refresh_token", "scope": "",
                         "network": "", "refresh_token": tok}, auth=False)
    if not ok:
        msg = resp.get("message") if isinstance(resp, dict) else str(resp)[:200]
        die(f"refresh exchange failed: {msg} — Unstop currently rejects "
            f"refresh-token grants (verified); use `unstop login` instead")
    _finish_socialish(resp, "refresh-token")


