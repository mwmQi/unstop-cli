BLOG_BASE = BASE + "/blog/"


def _strip_html(s):
    s = re.sub(r"<[^>]+>", " ", s or "")
    import html as _h
    return re.sub(r"\s+", " ", _h.unescape(s)).strip()


def _fetch_full_post(ident):
    """Full post by slug via /api/public/post/<slug>, fallback ?slug=."""
    payload = api_get("/api/public/post/" + ident, quiet=True) or {}
    d = payload.get("data")
    if isinstance(d, dict) and d.get("post"):
        return d["post"]
    payload = api_get("/api/public/posts", {"slug": ident}, quiet=True) or {}
    items = payload.get("data")
    if isinstance(items, list) and items:
        return items[0]
    return None


def cmd_blogs(args):
    """Public blog posts. Optional keyword filter (client-side)."""
    kw = " ".join(args.query).lower() if args.query else None
    page, seen = 1, []
    want_cats = set(args.category) if args.category else None
    while page <= args.pages:
        payload = api_get("/api/public/posts",
                          {"lessData": "true", "per_page": 20,
                           "page": page}, quiet=True) or {}
        d = payload.get("data")
        items = d.get("data") if isinstance(d, dict) else d
        if not items:
            break
        for p in items:
            if want_cats is not None:
                pcats = {cat.get("id") for cat in (p.get("all_categories") or [])}
                if not (pcats & want_cats):
                    continue
            title = p.get("post_title") or "?"
            if kw and kw not in title.lower() and kw not in _strip_html(
                    p.get("post_excerpt") or "").lower():
                continue
            seen.append(p)
        total_pages = d.get("last_page") if isinstance(d, dict) else None
        if len(seen) >= max(args.limit, 40) or len(items) < 20 \
                or (total_pages and page >= total_pages):
            break
        page += 1
    shown = 0
    for i, p in enumerate(seen[:args.limit], 1):
        slug = p.get("post_name") or ""
        date = (p.get("published_at") or "")[:10]
        print(f"{c(str(i).rjust(3), DIM)} {c((p.get('post_title') or '?')[:78], BOLD)}")
        bits = [x for x in (date, BLOG_BASE + slug) if x]
        if bits:
            print("     " + " · ".join([c(bits[0], CYAN)] + bits[1:]))
        print()
        shown += 1
    if not shown:
        print(c("No blog posts matched.", YELLOW))
    else:
        print(c("read one: unstop blog <slug-or-id>", DIM))


def cmd_blog(args):
    """Read one post: prints title, meta and full cleaned text."""
    ident = str(args.id)
    p = _fetch_full_post(ident)
    if p is None:
        die(f"post '{ident}' not found (try `unstop blogs`)")
    body = _strip_html(p.get("post_content") or "")
    wrapped = textwrap.fill(body, width=88)
    print(c(p.get("post_title") or "?", BOLD))
    print(c("-" * min(len(p.get("post_title") or ""), 60), DIM))
    meta = []
    if p.get("published_at"):
        meta.append(p["published_at"][:10])
    author = p.get("authorName") or (
        "#" + str(p["post_author"]) if p.get("post_author") else None)
    if author:
        meta.append(str(author))
    cats = ", ".join(x.get("name", "") for x in (p.get("categoriesName") or [])
                     ) if isinstance(p.get("categoriesName"), list) else ""
    if cats:
        meta.append(cats)
    meta.append(BLOG_BASE + (p.get("post_name") or ""))
    print(" · ".join(m for m in meta if m)); print()
    if not wrapped:
        print(c("(no body returned for this post)", YELLOW))
    else:
        print(wrapped)
    if args.json:
        print(); print(json.dumps(p, indent=2, ensure_ascii=False)[:6000])


