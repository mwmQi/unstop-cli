def cmd_me(args):
    """Everything a normal person sees about their own activity."""
    p = _profile_decrypted()
    if not isinstance(p, dict) or not p:
        die("not logged in — run `unstop login`")
    if args.json:
        print(json.dumps(p, indent=2, ensure_ascii=False))
        return
    interesting = ("id", "username", "email", "mobile", "name",
                   "user_category", "profile_percentage", "coins",
                   "isProMember", "city", "country",
                   "course_programme", "course_pursuing",
                   "course_specialization", "career_goal")
    rows = [(k, p.get(k)) for k in interesting
            if p.get(k) not in (None, "", [], {})]
    if not rows:
        rows = [(k, v) for k, v in sorted(p.items())
                if v not in (None, "", [], {})][:15]
    w = max(len(k) for k, _ in rows)
    for k, v in rows:
        print(f"{c((k + ':').ljust(w + 1), CYAN)} {v}")


def _authed_list(path, params=None):
    payload = api_get(path, params or {}, quiet=True)
    d = payload.get("data") if isinstance(payload, dict) else None
    items = d.get("data") if isinstance(d, dict) else d
    if items:
        return items
    # some endpoints are POST-only
    ok, resp = api_post(path, params or {}, quiet=True)
    d = resp.get("data") if isinstance(resp, dict) else None
    items = (d.get("data") if isinstance(d, dict) else d)
    return items or []


def cmd_registrations(args):
    """Opportunities I am registered in."""
    items = _authed_list("/api/user/get-registered-user")
    if args.json:
        print(json.dumps(items, indent=2, ensure_ascii=False))
        return
    if not items:
        print(c("No registrations found.", YELLOW))
        return
    print(c(f"── my registrations · {len(items)} ──", BOLD))
    print()
    for i, r in enumerate(items[:args.limit], 1):
        opp = r.get("opportunity") or r
        title = opp.get("title") or r.get("title") or "?"
        org = ((opp.get("organisation") or {}).get("name")
               if isinstance(opp.get("organisation"), dict) else "") \
              or r.get("organisation_name") or ""
        status = r.get("moderation_status") or r.get("status") or ""
        line = f"{c(str(i).rjust(3), DIM)} {c(title[:70], BOLD)}"
        if org:
            line += f"\n     {c(org, CYAN)}"
        if status:
            line += c(f" · {status}", DIM)
        oid = opp.get("id") or r.get("opportunity_id") or ""
        if oid:
            line += f"   #{oid}"
        print(line)


