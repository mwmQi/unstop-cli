# ---------------------------------------------------------------- session
def load_auth():
    try:
        with open(AUTH_FILE) as f:
            return json.load(f)
    except Exception:
        return {}


def save_auth(sess):
    os.makedirs(os.path.dirname(AUTH_FILE), exist_ok=True)
    fd = os.open(AUTH_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(sess, f, indent=1, ensure_ascii=False)
    try:
        os.chmod(AUTH_FILE, 0o600)
    except OSError:
        pass


def clear_auth():
    try:
        os.remove(AUTH_FILE)
    except FileNotFoundError:
        pass


# ------------------------------------------------------- encData decrypt
_ENC_KEY = base64.b64decode(
    "NEpLU3BZQlFvWkJxdStCOUpIVFJhSWkwMlpmRHhmREM=")


def decrypt_encdata(enc_b64):
    """Decrypt an `encData` blob -> python object (AES-256-CBC)."""
    t = json.loads(base64.b64decode(enc_b64))
    ct = base64.b64decode(t["value"])
    iv = base64.b64decode(t["iv"])
    try:
        from cryptography.hazmat.primitives.ciphers import (
            Cipher, algorithms, modes)
        dec = Cipher(algorithms.AES(_ENC_KEY), modes.CBC(iv)).decryptor()
        pt = dec.update(ct) + dec.finalize()
    except ImportError:
        # openssl fallback: hex stream, strip PKCS7
        hexin = (ct + iv).hex()
        raw = subprocess.run(
            ["openssl", "enc", "-d", "-aes-256-cbc", "-K", _ENC_KEY.hex(),
             "-iv", iv.hex()], input=bytes.fromhex(hexin),
            capture_output=True).stdout
        pt = raw
    pt = pt[:-pt[-1]] if pt and pt[-1] <= 16 else pt      # unpad PKCS7
    s = pt.decode("utf-8", "replace")
    m = re.search(r"\{.*\}", s, re.S)                     # strip s:N:"..." wrapper
    return json.loads(m.group(0)) if m else None


